# Copy to .env.local for local overrides. Only VITE_-prefixed variables reach
# the browser, and everything that reaches the browser is public. Never put a
# secret here.

# Where the app sends API calls. A relative path means requests go to whatever
# origin served the app: the Vite proxy in development, nginx in a container.
VITE_API_BASE_URL=/api/v1

# Where the dev server forwards /api during `npm run dev`.
VITE_API_PROXY_TARGET=http://127.0.0.1:8000

# Answer every API call inside the browser from mock_data/ instead of calling
# Django, so the app runs with no backend and no database. Unset means on in
# `npm run dev` and off in `npm run build`; set it to force either way.
# See mock_data/README.md.
# VITE_USE_MOCK_API=false

# Artificial delay per mocked request, so loading states are visible. 0 for
# instant. Ignored when the mock is off.
# VITE_MOCK_LATENCY_MS=180

# Start the mocked session already signed in. Set to false to land on the
# login screen instead. Ignored when the mock is off.
# VITE_MOCK_AUTO_SIGN_IN=false
